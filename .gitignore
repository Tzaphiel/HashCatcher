# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# PyInstaller build/output artifacts
build/
dist/

# Debian packaging artifacts (generated by scripts/build_deb.sh)
package/
*.deb

# Virtual environments
.venv/
venv/
env/

# Editor / OS cruft
.vscode/
.idea/
*.swp
.DS_Store

# Captures and generated hash files (user data, never commit)
*.cap
*.pcap
*.pcapng
*.22000
output/

# Flatpak local build cache
.flatpak-builder/
